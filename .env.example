# Salin file ini menjadi .env lalu isi nilainya.
PORT=3000
NODE_ENV=production

# Kunci rahasia JWT — WAJIB diganti dengan string acak panjang.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_panjang
REFRESH_TOKEN_SECRET=ganti_dengan_string_acak_lain

ADMIN_EMAIL=admin@p4us.local
# Password superadmin. Diisi = jadi password tetap (ubah di sini lalu restart).
# Kosongkan = password acak dibuat sekali saat init (dicetak di terminal).
ADMIN_PASSWORD=Kopassus123

RECORDINGS_DIR=./backend/recordings
FFMPEG_PATH=ffmpeg
ALLOWED_ORIGINS=http://localhost:3000

# Bridge operator K3I Korlantas — isi dengan kredensial operator Anda sendiri.
K3I_BASE_URL=https://k3i.korlantas.polri.go.id/api/web
K3I_USERNAME=
K3I_PASSWORD=
K3I_OPERATION_ID=286
