PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=change_this_to_another_random_64_char_string
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin
ADMIN_EMAIL=admin@p4us.local
ADMIN_PASSWORD=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM=P4US CCTV <noreply@p4us.local>

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Recordings directory (absolute path recommended)
RECORDINGS_DIR=./backend/recordings

# FFmpeg path (optional, for RTSP transcoding and recording)
FFMPEG_PATH=ffmpeg
